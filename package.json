{
  "name": "@dvfc/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Data Viz Factory - Cross-filtered boards for humans and agents",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='!@dvfc/example-*' build",
    "dev": "pnpm -r --parallel --filter='!@dvfc/example-*' dev",
    "clean": "pnpm -r --parallel clean && rm -rf dist node_modules",
    "mcp": "node packages/mcp/dist/server.js",
    "dogfood": "./scripts/dogfood.sh",
    "test": "pnpm -r --filter='@dvfc/charts' test",
    "example:sales": "pnpm --filter @dvfc/example-sales-board dev",
    "example:build": "pnpm --filter @dvfc/example-sales-board build",
    "example:preview": "pnpm --filter @dvfc/example-sales-board preview"
  },
  "keywords": [
    "dashboard",
    "analytics",
    "mosaic",
    "dbt",
    "visualization",
    "crossfilter"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://origin.cursor.com/git/kobakhit/tmp-7a5579056a50c222.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
