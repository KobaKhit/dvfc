{
  "name": "@dvfc/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Data Viz Factory - chart/dash compiler with Mosaic + Vega export",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='!@dvfc/example-*' build",
    "dev": "pnpm -r --parallel --filter='!@dvfc/example-*' dev",
    "clean": "pnpm -r --parallel clean && rm -rf dist node_modules",
    "mcp": "node packages/mcp/dist/server.js",
    "dogfood": "./scripts/dogfood.sh",
    "test": "pnpm -r --filter='@dvfc/charts' --filter='@dvfc/core' --filter='@dvfc/resolve' --filter='@dvfc/render-vega' test",
    "example:sales": "pnpm --filter @dvfc/example-sales-board dev",
    "example:build": "pnpm --filter @dvfc/example-sales-board build",
    "example:preview": "pnpm --filter @dvfc/example-sales-board preview",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude='**/test/**' --test packages/core/test/**/*.test.ts packages/charts/test/**/*.test.ts packages/resolve/test/**/*.test.ts packages/render-vega/test/**/*.test.ts"
  },
  "keywords": [
    "dashboard",
    "analytics",
    "mosaic",
    "dbt",
    "visualization",
    "crossfilter"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
