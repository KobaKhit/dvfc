{
  "id": "cosmic-landing",
  "title": "Other Worlds",
  "description": "Brush the timeline, click a slice, or brush the scatter — every view stays in sync.",
  "version": "0.2.0",
  "coordination": { "auto": true },
  "data": [{ "id": "worlds", "type": "csv", "path": "exoplanets.csv" }],
  "charts": [
    {
      "id": "field_note",
      "type": "text",
      "content": "**Brush the timeline** to filter every view.\n\nClick a donut slice or brush the scatter — linking is declared in the spec, not wired in JavaScript."
    },
    {
      "id": "world_count",
      "type": "number",
      "title": "Worlds in view",
      "dataSource": "worlds",
      "encoding": { "y": { "field": "planet", "aggregate": "count", "label": "Count" } },
      "interaction": { "filterBy": "era" }
    },
    {
      "id": "avg_habitability",
      "type": "number",
      "title": "Avg habitability",
      "dataSource": "worlds",
      "encoding": { "y": { "field": "habitability_score", "aggregate": "avg", "label": "Avg habitability score" } },
      "interaction": { "filterBy": "era" }
    },
    {
      "id": "avg_distance",
      "type": "number",
      "title": "Avg distance (ly)",
      "dataSource": "worlds",
      "encoding": { "y": { "field": "distance_ly", "aggregate": "avg", "label": "Avg distance ly" } },
      "interaction": { "filterBy": "era" }
    },
    {
      "id": "discovery_timeline",
      "type": "area",
      "title": "Discoveries over time",
      "dataSource": "worlds",
      "encoding": {
        "x": { "field": "discovery_year", "type": "ordinal", "label": "Discovery year" },
        "y": { "field": "planet", "aggregate": "count", "label": "Count" }
      },
      "interaction": {
        "brush": true,
        "brushAxis": "x",
        "publishes": "era",
        "filterBy": "era"
      },
      "height": 260
    },
    {
      "id": "discovery_methods",
      "type": "donut",
      "title": "By discovery method",
      "dataSource": "worlds",
      "encoding": {
        "x": { "field": "method", "type": "nominal", "label": "Method" },
        "y": { "field": "planet", "aggregate": "count", "label": "Count" }
      },
      "interaction": {
        "filterBy": "era",
        "publishes": "era",
        "select": "auto"
      },
      "height": 260
    },
    {
      "id": "habitability_scatter",
      "type": "scatter",
      "title": "Habitability vs temperature",
      "dataSource": "worlds",
      "encoding": {
        "x": { "field": "equilibrium_k", "type": "quantitative", "label": "Equilibrium k" },
        "y": { "field": "habitability_score", "type": "quantitative", "label": "Habitability score" },
        "color": { "field": "method", "type": "nominal" }
      },
      "interaction": { "filterBy": "era" },
      "height": 280
    },
    {
      "id": "missions_bar",
      "type": "bar",
      "title": "Worlds by mission",
      "dataSource": "worlds",
      "encoding": {
        "x": { "field": "mission", "type": "nominal", "label": "Mission" },
        "y": { "field": "planet", "aggregate": "count", "label": "Count" }
      },
      "interaction": { "filterBy": "era" },
      "height": 280
    }
  ],
  "layout": { "type": "grid", "rows": [4, 2, 2], "gap": 16 },
  "theme": {
    "colors": ["#1e3a5f", "#7ba3c9", "#a89b8c", "#4a7c9b"],
    "fontFamily": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "backgroundColor": "white"
  }
}
