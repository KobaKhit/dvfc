{
  "name": "@dvfc/dbt-adapter",
  "version": "0.1.0",
  "description": "dbt manifest resolver for Data Viz Factory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dvfc/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dbt",
    "manifest",
    "data-transformation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  }
}
