{
  "name": "@dvfc/charts",
  "version": "0.2.0",
  "description": "Chart discovery and addressability for Data Viz Factory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@dvfc/core": "workspace:*",
    "yaml": "^2.7.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dvfc",
    "data-viz-factory",
    "charts",
    "discovery",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  }
}
