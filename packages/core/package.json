{
  "name": "@dvfc/core",
  "version": "0.2.0",
  "description": "Core types, IR (chart/dash), schemas, and chart-type registry for dvfc",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/schema.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc && node --experimental-strip-types ../../scripts/dump-schemas.ts",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "glob": "^10.3.10",
    "smol-toml": "^1.3.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "mosaic",
    "dbt",
    "analytics",
    "dvfc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  }
}
