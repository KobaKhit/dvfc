{
  "name": "@coordboard/core",
  "version": "0.1.0",
  "description": "Core types and schemas for coordboard dashboard specifications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "mosaic",
    "dbt",
    "analytics"
  ]
}
