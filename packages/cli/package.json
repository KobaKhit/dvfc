{
  "name": "@coordboard/cli",
  "version": "0.1.0",
  "description": "CLI tool for coordboard - preview and build dashboards",
  "type": "module",
  "bin": {
    "coordboard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coordboard/core": "workspace:*",
    "@coordboard/dbt-adapter": "workspace:*",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@uwdata/vgplot": "^0.31.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "vite": "^8.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "cli",
    "mosaic",
    "analytics"
  ]
}
