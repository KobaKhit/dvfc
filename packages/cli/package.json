{
  "name": "@coordboard/cli",
  "version": "0.1.0",
  "description": "CLI tool for coordboard - preview and build dashboards",
  "type": "module",
  "bin": {
    "coordboard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coordboard/core": "workspace:*",
    "@coordboard/dbt-adapter": "workspace:*",
    "yaml": "^2.7.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "cli",
    "mosaic",
    "analytics"
  ]
}
