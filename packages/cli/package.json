{
  "name": "@dvfc/cli",
  "version": "0.1.0",
  "description": "CLI tool for Data Viz Factory - preview and build dashboards",
  "type": "module",
  "bin": {
    "dvfc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dvfc/build": "workspace:*",
    "@dvfc/core": "workspace:*",
    "@dvfc/charts": "workspace:*",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "keywords": [
    "dashboard",
    "cli",
    "mosaic",
    "analytics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  }
}
