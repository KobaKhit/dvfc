{
  "name": "@dvfc/mcp",
  "version": "0.1.0",
  "description": "MCP server for Data Viz Factory - build cross-filtered dashboards with AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dvfc-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "test": "pnpm build && node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@dvfc/core": "workspace:*",
    "@dvfc/adapter-dbt": "workspace:*",
    "@dvfc/build": "workspace:*",
    "@dvfc/charts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dashboard",
    "mosaic",
    "ai",
    "coordinated-views"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KobaKhit/dvfc.git"
  },
  "homepage": "https://github.com/KobaKhit/dvfc#readme",
  "bugs": {
    "url": "https://github.com/KobaKhit/dvfc/issues"
  }
}
