{
  "name": "@dvfc/build",
  "version": "0.1.0",
  "description": "Shared validate + HTML/SVG build pipeline for dvfc CLI and MCP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "pnpm build && node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@dvfc/core": "workspace:*",
    "@dvfc/adapter-dbt": "workspace:*",
    "@dvfc/render-mosaic": "workspace:*",
    "@dvfc/render-vega": "workspace:*",
    "@dvfc/render-dc": "workspace:*",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@uwdata/mosaic-core": "^0.31.0",
    "@uwdata/vgplot": "^0.31.0",
    "ajv": "^8.20.0",
    "crossfilter2": "^1.5.4",
    "d3": "^7.9.0",
    "dc": "^4.2.7",
    "vite": "^8.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "license": "Apache-2.0"
}
